{
  "name": "wopi-host",
  "version": "1.0.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:indexes": "node --env-file=.env scripts/create-mongo-indexes.mjs",
    "db:migrate-file-identities": "node --env-file=.env scripts/migrate-file-identities.mjs",
    "minio:versioning": "./scripts/enable-minio-versioning.sh",
    "test": "npm run build && node --test",
    "test:watch": "npm run build && node --test --watch",
    "minio:verify-conditional-write": "node scripts/verify-minio-conditional-write.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@nestjs/axios": "^12.0.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.15",
    "axios": "^1.21.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fast-xml-parser": "^5.2.0",
    "joi": "^18.3.2",
    "mongoose": "^8.9.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.6"
  }
}
