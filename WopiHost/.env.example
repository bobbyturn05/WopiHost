NODE_ENV=development
PORT=3100
PUBLIC_WOPI_ORIGIN=http://localhost:3100

MONGODB_URI=mongodb://localhost:27017/wopi
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_REGION=us-east-1
MINIO_VERSIONED_BUCKETS=documents

LAUNCH_TOKEN_TTL_SECONDS=120
WOPI_ACCESS_TOKEN_TTL_SECONDS=28800
MAX_FILE_SIZE_BYTES=52428800
WOPI_MAX_CONCURRENT_UPLOADS=4
WOPI_LOCK_TTL_SECONDS=1800
WOPI_OPERATION_LEASE_TTL_SECONDS=120
WOPI_FILE_ID_SECRET=replace-with-stable-random-secret-at-least-32-characters
WOPI_SERVER_VERSION=1.0.0
WOPI_MACHINE_NAME=wopi-host

OFFICE_DISCOVERY_URL=https://office.example.com/hosting/discovery
OFFICE_DISCOVERY_ZONE=external-https
OFFICE_ALLOWED_ORIGINS=https://office.example.com
