NODE_ENV=development
PORT=3100
PUBLIC_WOPI_ORIGIN=https://wopi.example.com
MONGODB_URI=mongodb://localhost:27017/wopi
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# Set either a full URL (recommended) or a hostname. If hostname-only, MINIO_PORT and MINIO_USE_SSL are used.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_REGION=us-east-1
MINIO_VERSIONED_BUCKETS=documents

LAUNCH_TOKEN_TTL_SECONDS=120
WOPI_ACCESS_TOKEN_TTL_SECONDS=3600
MAX_FILE_SIZE_BYTES=104857600
WOPI_LOCK_TTL_SECONDS=1800
WOPI_SERVER_VERSION=1.0.0
WOPI_MACHINE_NAME=wopi-host

# Use the discovery URL for the Office Online / Microsoft 365 deployment you are connecting to.
OFFICE_DISCOVERY_URL=https://onenote.officeapps.live.com/hosting/discovery

# Every bucket accepted by the internal session endpoint. Enable versioning before first write.
